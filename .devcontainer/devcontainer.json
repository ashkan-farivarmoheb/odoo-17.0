{
  "name": "Odoo Development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "odoo",
  "workspaceFolder": "/workspaces/odoo-17.0",
  "features": {
    "docker-in-docker": "latest"
  },
  "forwardPorts": [8069, 5432],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "remoteUser": "odoo"
}
