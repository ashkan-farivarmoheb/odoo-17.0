{
  "name": "Odoo Development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "odoo",
  "workspaceFolder": "/workspace",
  "features": {
    "docker-in-docker": "latest"
  },
  "forwardPorts": [8069, 5432, 6379, 8887, 8443],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "remoteUser": "vscode"
}
