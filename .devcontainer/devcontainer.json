{
  "name": "Odoo Development",
  "dockerComposeFile": "docker-compose.yml",
  "service": "odoo",
  "workspaceFolder": "/workspaces/odoo-17.0",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": "latest"
  },
  "forwardPorts": [8069, 5432],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "ms-python.vscode-pylance",
        "visualstudioexptteam.vscodeintellicode",
        "streetsidesoftware.code-spell-checker",
        "eamodio.gitlens",
        "wholroyd.jinja"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.formatting.provider": "black",
        "[python]": {
          "editor.formatOnSave": true,
          "editor.rulers": [88]
        }
      }
    }
  },
  "remoteUser": "odoo",
  // Add these resource requirements
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },
  // Add init process
  "init": true,
  // Add shutdown action
  "shutdownAction": "stopCompose",
  "postCreateCommand": "pip install black pylint",
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/usr/local/bin",
    "PYTHONPATH": "/usr/lib/python3/dist-packages"
  }
}
